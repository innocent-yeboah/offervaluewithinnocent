NEXT_PUBLIC_SITE_URL=https://offervaluewithinnocent.com

# Required on Vercel too (Settings → Environment Variables), then Redeploy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Required for contact notes and Join/Contact rate limits.
# Never use this key to render public article lists (Rule 3).
SUPABASE_SERVICE_ROLE_KEY=

KIT_API_KEY=
KIT_API_SECRET=
# Numeric id from the form editor URL, e.g. app.kit.com/forms/designers/1234567
# Do not paste an API key or API secret here.
KIT_FORM_ID=

# Optional. Contact form still stores messages without this.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Offer Value With Innocent <hello@offervaluewithinnocent.com>

# Server only. Admin writing helper. Never NEXT_PUBLIC_.
# Free path: https://aistudio.google.com/apikey  (Gemini is used until Claude is set)
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash.
GEMINI_MODEL=

# Paid path when you’re ready. If this is set, Claude is used instead of Gemini.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-4-5-20250929.
ANTHROPIC_MODEL=
